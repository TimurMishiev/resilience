{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.13.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "benchmark:globe": "playwright test e2e/globe-benchmark.spec.ts",
    "benchmark:map": "playwright test e2e/map-benchmark.spec.ts",
    "benchmark:map:scale": "playwright test e2e/map-scale-benchmark.spec.ts",
    "test:e2e": "playwright test --grep-invert benchmark",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.10.0",
