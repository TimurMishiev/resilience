    "@tanstack/react-virtual": "^3.13.23",
    "@xyflow/react": "^12.10.1",
    "cesium": "^1.139.1",
    "d3": "^7.9.0",
    "maplibre-gl": "^5.20.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0"
  },
  "resolutions": {
    "serialize-javascript": "^7.0.3",
    "protobufjs": "^8.0.1",
