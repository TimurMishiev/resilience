# Vite dev server proxy — forwards /api/* to the Rails backend.
# Copy this file to .env.local to override locally.
VITE_API_TARGET=http://localhost:3000

# Classification banner — shown at top and bottom of every page.
# Options: UNCLASSIFIED (default, green) | CUI (amber) | SECRET (red)
VITE_CLASSIFICATION_LEVEL=UNCLASSIFIED

# Optional frontend/browser Sentry DSN. This value is public and is compiled
# into the SPA bundle, so use the public browser DSN for your Sentry project.
VITE_SENTRY_DSN=

# Optional environment/release overrides for frontend events.
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
