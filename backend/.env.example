# Copy this file to .env and fill in the values.
# Never commit .env — it is gitignored.

# Anthropic API key — used by the AI briefing and filter endpoints.
ANTHROPIC_API_KEY=

# Allowed CORS origins for the frontend (comma-separated in production).
# Defaults to http://localhost:5173 in development.
CORS_ORIGINS=http://localhost:5173

# Rails secret key base — generate with: bin/rails secret
# Required in production; Rails uses credentials in development.
# SECRET_KEY_BASE=

# ── Phase D: Live Intelligence Feeds ─────────────────────────────────────────

# OpenSky Network credentials — enables aircraft position feed (aircraft_position signals).
# Free registration: https://opensky-network.org/
# Authenticated limit: 4,000 req/day vs 400/day anonymous — required for reliable dev use.
# Leave blank to disable the OpenSky feed; USGS seismic and GPSJam run without any key.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# AIS Hub username — enables AIS vessel position feed (vessel_position signals).
# Free registration: https://www.aishub.net/join-us
# Leave blank to disable the AIS feed.
AISHUB_USERNAME=

# NASA FIRMS map key — enables NASA wildfire detection feed (wildfire signals).
# Free API key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Requires EarthData account (free, instant approval).
NASA_FIRMS_MAP_KEY=
