# Copy this file to .env and fill in the values.
# Never commit .env — it is gitignored.
#
# QUICK START (two required values):
#   1. SECRET_KEY_BASE — run:  cd backend && bin/rails secret
#      Paste the output below.
#   2. ANTHROPIC_API_KEY — only needed for the AI Briefing page.
#      Get one free at https://console.anthropic.com/
#      Leave blank to skip — everything else works without it.

# ── Required ─────────────────────────────────────────────────────────────────

# Rails secret key base — signs JWT tokens and sessions.
# Generate with:  cd backend && bin/rails secret
SECRET_KEY_BASE=

# ── Optional: AI Briefing ─────────────────────────────────────────────────────

# Anthropic API key — used by the AI briefing and filter endpoints.
# Get a free key at https://console.anthropic.com/
# Leave blank to disable the AI Briefing page; all other features work without it.
ANTHROPIC_API_KEY=

# ── Optional: CORS ────────────────────────────────────────────────────────────

# Allowed CORS origins for the frontend (comma-separated).
# The Vite dev server proxies /api/* to :3000 so CORS is not needed in development.
# Only set this if you are running the frontend separately in production.
# CORS_ORIGINS=http://localhost:5176

# ── Optional: Live Intelligence Feeds ────────────────────────────────────────
# All five signal types are visible immediately after db:seed via demo data.
# Add credentials below to enable real-time feeds from external sources.

# OpenSky Network — live aircraft positions (aircraft_position signals).
# Runs anonymously without credentials (300s startup delay, lower rate limit).
# Free registration for higher limits: https://opensky-network.org/
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# AIS Hub — live vessel positions (vessel_position signals).
# Free registration: https://www.aishub.net/join-us
AISHUB_USERNAME=

# NASA FIRMS — live wildfire detections (wildfire signals).
# Free API key (requires free EarthData account): https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=
